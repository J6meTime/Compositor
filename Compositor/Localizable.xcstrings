    "Layer Mask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层蒙版"
          }
        }
      }
    },
    "Don't Save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不存储"
          }
        }
      }
    },
    "Couldn't change canvas size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改画布大小"
          }
        }
      }
    },
    "Couldn't export JPEG": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导出 JPEG"
          }
