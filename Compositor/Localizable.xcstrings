    },
    "Couldn't export PNG": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导出 PNG"
          }
        }
      }
    },
    "Couldn't open the project": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开项目"
          }
        }
      }
    },
    "Couldn't resize the image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法调整图像大小"
          }
        }
      }
    },
    "Couldn't save the project": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储项目"
          }
        }
      }
    },
    "Couldn't trim image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法裁剪图像"
          }
        }
      }
    },
    "Current: %@ × %@ pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前：%@ × %@ 像素"
          }
        }
      }
    },
    "%lld more tabs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 个标签页"
          }
        }
      }
    },
    "1 more tab": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 1 个标签页"
          }
        }
      }
    },
    "%@. Double-click to reset.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。双击复位。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像上拖动以移动指针下方色调的曲线。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，在中间调中最强。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向最暗色调添加绿色或洋红色。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化较大形状的对比度。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化小细节。"
          }
        }
      }
    },
    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图像的亮部。按住 Option 查看溢出的高光。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图像的暗部。按住 Option 查看溢出的阴影。"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗边角以补偿镜头衰减。"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗整个图像，以档为单位。按住 Option 查看溢出的高光。"
          }
        }
      }
    },
    "Brightness added by this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此滚轮添加的亮度。"
          }
        }
      }
    },
    "Chooses how bright an area must be to glow. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择发光区域所需的亮度。在提高发光值之前无效。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高时清除雾气，降低时添加雾气。"
          }
        }
      }
    },
    "Controls how strong the sharpening is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化的强度。"
          }
        }
      }
    },
    "Darkens or lightens the edges. The center does not change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮边缘。中心不变。"
          }
        }
      }
    },
    "Emphasizes fine texture over broader edges.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调细纹理而非粗大边缘。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从每个边缘延伸的距离，以像素为单位。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在亮度上的影响范围。"
          }
        }
      }
    },
    "How far in hue the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在色相上的影响范围。"
          }
        }
      }
    },
    "How far in saturation the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在饱和度上的影响范围。"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的配置文件畸变校正量。"
          }
        }
      }
    },
    "How much of the profile vignetting correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的配置文件暗角校正量。"
          }
        }
      }
    },
    "Hue range where green defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色去边运行的色相范围。"
          }
        }
      }
    },
    "Hue range where purple defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色去边运行的色相范围。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在亮度平滑后保留局部对比度。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锐化限制在较强的边缘。按住 Option 查看蒙版。"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使亮调和暗调的差异增大或减小，主要在中间调附近。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颜色平滑更柔和或更紧凑。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更粗或更细。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更平滑或更不均匀。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使选取的颜色更亮或更暗。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使选取的颜色更强或更弱。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使暗角更圆或更方。"
          }
        }
      }
    },
    "Moves the picture left or right.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移动图像。"
          }
        }
      }
    },
    "Moves the picture up or down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下移动图像。"
          }
        }
      }
    },
    "Moves the vignette correction inward or outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向内或向外移动暗角校正。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少颜色噪点时保留彩色边缘。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少亮度噪点时保留细纹理。"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗角时保护亮像素。由高光优先使用。"
          }
        }
      }
    },
    "Rotates the picture around its center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕中心旋转图像。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置发光的延伸范围。在提高发光值之前无效。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最亮点。按住 Option 查看溢出的高光。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最暗点。按住 Option 查看溢出的阴影。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置暗角起始位置，从中心向外。"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整蓝色的解释方式。"
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整绿色的解释方式。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整红色的解释方式。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发光从冷色偏移到暖色。光晕保持红色。在提高发光值之前无效。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿色轮移动选取的颜色。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图像从蓝色偏移到黄色。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图像从绿色偏移到紫红色。"
          }
        }
      }
    },
    "Smooths colored speckles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑彩色斑点。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑亮度中的颗粒和噪点。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化暗角边缘。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从亮部扩散发光。"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正桶形或枕形弯曲。"
          }
        }
      }
    },
    "Straightens horizontal lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将水平线向中心校正。"
          }
        }
      }
    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将垂直线向中心校正。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等量增强或减弱所有颜色。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱绿色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱红色原色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对弱色的增强多于已强色，并保护肤色。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于高度拉伸宽度。"
          }
        }
      }
    },
    "Weakens green fringes inside the green hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱绿色色相范围内的绿边。"
          }
        }
      }
    },
    "Weakens purple fringes inside the purple hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱紫色色相范围内的紫边。"
          }
        }
      }
    },
    "Zooms the transformed picture within the frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画框内缩放变换后的图像。"
          }
        }
      }
    },
    "Radial": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "径向"
          }
        }
      }
    },
    "Add": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Freehand": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由"
          }
        }
      }
    },
    "Polygonal": {
      "extractionState": "manual",
