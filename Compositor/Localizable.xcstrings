          }
        }
      }
    },
    "New blank layer (⇧⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建空白图层 (⇧⌘N)"
          }
        }
      }
    },
    "Color for the added canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增画布的颜色"
          }
        }
      }
    },
    "Preset sizes for screens and common formats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕和常规格式的预设大小"
          }
        }
      }
    },
    "Drop to open in a new canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放以在新画布中打开"
          }
        }
      }
    },
    "Paint with the foreground color (B), or erase pixels away (E)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用前景色绘画 (B)，或擦除像素 (E)"
          }
        }
      }
    },
    "Select layers by clicking the canvas. Hold Command to turn it the other way while you click.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击画布选择图层。按住 Command 反向选择。"
          }
        }
      }
    },
    "Shapes fill with the foreground color; click to change it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状以前景色填充；点击更改"
          }
        }
      }
    },
    "Shift-U (or Tab) steps through Rectangle, Ellipse and Line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-U（或 Tab）在矩形、椭圆和直线间切换"
          }
        }
      }
    },
    "Press M to switch between Rectangle and Ellipse": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 M 在矩形和椭圆间切换"
          }
        }
      }
    },
    "Press L to switch between Freehand and Polygonal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 L 在自由套索和多边形套索间切换"
          }
        }
      }
    },
    "Press Tab to switch between Wand and Object": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Tab 在魔棒和对象间切换"
          }
        }
      }
    },
    "Press 1–9 for 10–90%, 0 for 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 1–9 为 10–90%，0 为 100%"
          }
        }
      }
    },
    "Hold Shift to add or Option to subtract for one outline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 添加或 Option 减去一个轮廓"
          }
        }
      }
    },
    "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定宽高比。拖动控制点时按住 Shift 可反向调整。"
          }
        }
      }
    },
    "Scale width and height together, about the center": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时缩放宽度和高度，以中心为准"
          }
        }
      }
    },
    "Remove every guide line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有参考线。"
          }
        }
      }
    },
    "Font face, including bold and italic variants": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体，包括粗体和斜体变体"
          }
        }
      }
    },
    "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行高，基线到基线。留空或 0 为自动：字号的 120%。"
          }
        }
      }
    },
    "The height of each line of characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行字符的高度"
          }
        }
      }
    },
    "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画笔以此长度拖尾跟随指针，使抖抖的手仍能画出平滑线条"
          }
        }
      }
    },
    "Tones per channel: 2 is pure black and white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每通道色调数：2 为纯黑白"
          }
        }
      }
    },
    "More ink (darker) or less before dithering": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抖动前墨色多少（深或浅）"
          }
        }
      }
    },
    "Break the lines into glowing beads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线条断开为发光珠点"
          }
        }
      }
    },
    "Light blooming around the lines, like a CRT's phosphors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线条周围的光晕，如同 CRT 荧光体"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使线条在屏幕上摆动，如同 CRT 失同步"
          }
        }
      }
    },
    "Blend the chosen color into the edges while keeping the center unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选颜色混入边缘，同时保持中心不变"
          }
        }
      }
    },
    "Clear the haze that leaves background showing through thin areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除背景透过薄区域显现的雾韾"
          }
        }
      }
    },
    "Liquify pushes pixels · Blur softens · Smudge drags color along": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液化推移像素 · 模糊柔化 · 涂抹拖动颜色"
          }
        }
      }
    },
    "How far the blur softens, in pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊柔化的范围，以像素计"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素误差扩散到邻居的比例。越少区域越平坦"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动设置色相和饱和度。双击重置此色轮。"
          }
        }
      }
    },
    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动平衡平均颜色。自定跟随色温和色调。"
          }
        }
      }
    },
    "Applies generic profile strength when camera metadata is not available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当相机元数据不可用时应用通用配置强度。"
          }
        }
      }
    },
    "Analyze the active layer only, or every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析当前图层或所有可见图层"
          }
        }
      }
    },
    "Copy from the active layer only, or from every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层拷贝，或从所有可见图层拷贝"
          }
        }
      }
    },
    "Read colors from the active layer only, or from every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层读取颜色，或从所有可见图层读取"
          }
        }
      }
    },
    "Match the clicked pixel, or the average of the pixels around it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配点击的像素，或其周围像素的平均值"
          }
        }
      }
    },
    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色偏离所选颜色多远仍能被选中"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道 (0–255) 偏离点击颜色多远仍能被选中"
          }
        }
      }
    },
    "Select everything except those colors, such as all but a green screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择除这些颜色以外的所有区域，如除绿幕外的所有"
          }
        }
      }
    },
    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个应为中性的像素。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击紫色或绿色边缘设置其色相范围。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红色和蓝色边缘拉向中心以减少色边。"
          }
        }
      }
    },
    "Put each pixel's brightness back afterwards, so only the color moves": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后恢复每个像素的亮度，所以只移动颜色"
          }
        }
      }
    },
    "RGB changes brightness. Red, green, and blue also shift the color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 改变亮度。红、绿、蓝色还会偏移颜色。"
          }
        }
      }
    },
    "Red, green, and blue of the pixel under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针下方像素的红、绿、蓝色值。"
          }
        }
      }
    },
    "Click the picture to save a color. Up to eight colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图片以存储颜色。最多八个颜色。"
          }
        }
      }
    },
    "Select this picked color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此拾取的颜色。"
          }
        }
      }
    },
    "Click the original layer to set \\(mode.rawValue.lowercased()). Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击原始图层设置 \\(mode.rawValue.lowercased())。再次点击吸管停止。"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相偏移颜色，饱和度控制强度，明度控制亮度。"
          }
        }
      }
    },
    "Hue and saturation of this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此色轮的色相和饱和度。"
          }
        }
      }
    },
    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 列出所有颜色。颜色编辑一个色系。点颜色调整您选择的颜色。"
          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三路显示阴影、中调和高光。其他选项显示单个色轮。"
          }
        }
      }
    },
    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数式提升色调区域。点式在曲线上放置锚点。"
          }
        }
      }
    },
    "Input and output of the selected curve point.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定曲线点的输入和输出。"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上画两条或多条应水平或垂直的线。"
          }
        }
      }
    },
    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动图片中的颜色。附近色系一起移动。"
          }
        }
      }
    },
    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定向调整：拖动图像更改该颜色的饱和度，按住 Command 更改色相"
          }
        }
      }
    },
    "Fade the edge of the selection by this many pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以此像素数羽化选区边缘"
          }
        }
      }
    },
    "Enter a whole number from 1 to \\(maximum) px.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 1 到 \\(maximum) 像素的整数。"
          }
        }
      }
    },
    "Final dimensions must be 1–\\(DocumentLimits.maxSide.formatted()) pixels per side.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终尺寸每边必须为 1–\\(DocumentLimits.maxSide.formatted()) 像素。"
          }
        }
      }
    },
    "Round the rectangle's corners by this many pixels; 0 keeps them square": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以此像素数圆角矩形；0 保持直角"
          }
        }
      }
    },
    "How far apart the screen's lines are": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕线条之间的间距"
          }
        }
      }
    },
    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个抖动像素扩大为此像素数，营造粗糙的老屏幕效果"
          }
        }
      }
    },
    "Linear runs along the line; Radial spreads out from the start point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线性沿线运行；径向从起点向外扩散"
          }
        }
      }
    },
    "Protect bright areas near the edge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护边缘附近的亮区"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向内收紧检测蒙版；负值向外扩张"
          }
        }
      }
    },
    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蒙版拉到图像自身边缘，可恢复头发和毛发"
          }
        }
      }
    },
    "Shrink the mask to drop the rim of background color around the subject, or grow it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收缩蒙版以去除主体周围的背景色边缘，或扩展蒙版"
          }
        }
      }
    },
    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本快速；高级针对图层自身细节优化蒙版，适用于头发和毛发"
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或滚动平移；双击在适合和 100% 之间切换"
          }
        }
      }
    },
    "Choose the vignette color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择晕影颜色"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗此颜色范围外的图片。按确定后不会保留。"
          }
        }
      }
    },
    "Transparent canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明画布"
          }
        }
      }
    },
    "White canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白色画布"
          }
        }
      }
    },
    "Black canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色画布"
          }
        }
      }
    },
    "Pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素"
          }
        }
      }
    },
    "Inches": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英寸"
          }
        }
      }
    },
    "Centimeters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "厘米"
          }
        }
      }
    },
    "Millimeters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毫米"
          }
        }
      }
    },
    "Resolution: 72 for screens, 300 for print. Click to switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨率：屏幕用 72，打印用 300。点击切换。"
          }
        }
      }
    },
    "Start see-through, or with a white or black Background layer. Click to switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时透明，或选择白色/黑色背景图层。点击切换。"
          }
        }
      }
    },
    "Enter a size up to %@ pixels at this DPI.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不超过 %@ 像素的尺寸（当前 DPI）。"
          }
        }
      }
    },
    "%lld DPI: %lld × %lld pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld DPI: %lld × %lld 像素"
          }
        }
      }
    },
    "Bake and Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙并删除"
          }
        }
      }
    },
    "Remove Links and Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除链接并删除"
          }
        }
      }
    },
    "Revert": {
      "localizations": {
